{
  "name": "@agentc-sh/tdk",
  "version": "0.1.0",
  "description": "Typescript tool development kit for agentc",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format . --write",
    "build": "tsdown",
    "prepare": "pnpm build"
  },
  "keywords": [
    "agentc",
    "tool",
    "development",
    "kit",
    "tdk"
  ],
  "author": "agentc-sh Team <hello@agentc.sh>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
